# Copy to .env and fill in. Never commit .env.

# Redis Stack (docker compose up -d)
REDIS_URL=redis://localhost:6379

# Providers. Cloud is the default; local (ollama) is optional.
# Leave blank to be asked at start (planned, FR-31).
TOME_LLM_PROVIDER=
TOME_EMBEDDING_PROVIDER=

# Keys for the providers you use. Leave the others blank.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Obsidian vault
TOME_VAULT_PATH=
# Notes written by Tome go only here, relative to the vault root.
TOME_WRITE_FOLDER=Inbox/AI
